# Build Stage: Cài đặt dependencies với uv
FROM ghcr.io/astral-sh/uv:python3.11-bookworm-slim AS builder

WORKDIR /app

ENV UV_COMPILE_BYTECODE=1
ENV UV_LINK_MODE=copy

# Copy file dependencies
COPY pyproject.toml uv.lock ./

# Cài đặt dependencies vào /app/.venv
RUN uv sync --frozen --no-dev --no-install-project

# Production Stage: Runtime image tối ưu cho ECS
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy virtualenv từ builder stage
COPY --from=builder /app/.venv /app/.venv

# Đưa virtualenv vào PATH & cấu hình PYTHONPATH
ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONPATH="/app/src"
ENV PYTHONUNBUFFERED=1

COPY src ./src
COPY pyproject.toml README.md* ./

EXPOSE 8000

# Chạy FastAPI bằng uvicorn
CMD ["uvicorn", "app.main:app", "--app-dir", "src", "--host", "0.0.0.0", "--port", "8000"]
